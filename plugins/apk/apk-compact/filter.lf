#!/usr/bin/env lowfat-filter
# apk-compact — compact Alpine apk add/del/upgrade output.
# env: $sub $level $exit $args
#
# Bloat is the per-package `(N/M) Installing <pkg>` lines and `Executing
# <trigger>` rows. Signal is the trailing `OK: N MiB in N packages` summary and
# any WARNING/ERROR. On failure apk prints an `ERROR: unable to select packages`
# block — keep it. No JSON output path → no byte-exact guard needed.

# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define drop-chatter:
    drop /^(\([0-9]+\/[0-9]+\) (Installing|Purging|Upgrading) |Executing )/

*:
    if exit failed:
        keep /(ERROR|WARNING|error:|warning:|no such package|unsatisfiable|conflict|required by)/
        head-marked 40
        or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 40 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-40))"; fi; printf '%s\n' "$s" | tail -40
    else:
        match level:
            ultra:
                drop-chatter
                keep /(^OK:|ERROR|WARNING|error:|warning:)/
                head-marked 20
                or "apk: ok"
            lite:
                drop-chatter
                head-marked 200
            else:
                drop-chatter
                head-marked 60

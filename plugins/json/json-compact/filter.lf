#!/usr/bin/env lowfat-filter
# json-compact - preserve JSON byte-exact at full/lite; summarize huge arrays at ultra.
# env: $sub $level $exit $args

define ultra-json(limit):
    shell: |
        buf=$(mktemp)
        trap 'rm -f "$buf"' EXIT
        cat > "$buf"

        # Reshaping JSON needs a JSON parser. Without jq on PATH, or on anything
        # unparseable, the stream passes through untouched — a mangled JSON
        # stream is far worse than an uncompacted one (invariant 1).
        command -v jq >/dev/null 2>&1 || { cat "$buf"; exit 0; }
        jq -e . >/dev/null 2>&1 < "$buf" || { cat "$buf"; exit 0; }

        count=$(jq 'if type == "array" then length else -1 end' < "$buf")
        if [ "$count" -gt $1 ]; then
            jq --indent 2 ".[:$1] + [\"... ($((count - $1)) more)\"]" < "$buf"
        else
            cat "$buf"
        fi
        exit 0

pretty|compact:
    if exit failed:
        raw
    else:
        match level:
            ultra: ultra-json 12
            full:  raw
            lite:  raw

*:
    if exit failed:
        raw
    else:
        match level:
            ultra: ultra-json 12
            full:  raw
            lite:  raw

#!/usr/bin/env lowfat-filter
# docker-compose-compact - compact legacy docker-compose output.
# env: $sub $level $exit $args
#
# `--format json` (`ps`/`config`/`images --format json`) is machine output —
# pass byte-exact (invariant 1). Without the guard squeeze-columns reshapes it and
# the `*` drop-blank+head-auto truncates it (a 53-line `config --format json`
# fell to 15 at ultra). Guard the json value so default `--format table` /
# yaml still compacts.

# `head auto` cuts without a trace, so a truncated stream is indistinguishable from a
# genuinely short one and the reader acts on a confident wrong answer (issue #1). Mirrors
# `head auto`'s level limits (ultra 15 / full 30 / lite 60) and names what it dropped.
# Inventory listings are one load-bearing row per line: nothing is redundant, so no row
# may be dropped (invariant 6). Column padding is the only slack — squeezing runs of
# whitespace saves tokens without losing an item.
define squeeze-columns:
    python: |
        import re, sys

        for line in sys.stdin.read().rstrip("\n").splitlines():
            print(re.sub(r"[ \t]{2,}", " ", line))

define head-auto-marked:
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        limit = {"ultra": 15, "lite": 60}.get(level, 30)
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:limit]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define drop-compose-spam:
    drop /^$/
    drop /[[:space:]]+(Creating|Created|Starting|Started|Pulling|Pulled|Waiting|Recreating|Recreated)([[:space:]]|$)/
    drop /[[:space:]]+Pull complete$/
    drop /^Creating /
    drop /^Starting /
    drop /^Pulling /
    drop /^Waiting /

up|build:
    if exit failed:
        raw
    else:
        match level:
            ultra:
                drop-compose-spam
                keep /(error|Error|ERROR|exited with code|Successfully|Built|Building|Recreating|Attaching to)/
                tail 30
                or "docker-compose: ok"
            lite:
                drop-compose-spam
                tail 200
            else:
                drop-compose-spam
                tail 80

logs, ultra:
    if exit failed:
        raw
    else:
        tail 20

logs, full:
    if exit failed:
        raw
    else:
        tail 60

logs:
    if exit failed:
        raw
    else:
        tail 200

ps:
    if exit failed:
        raw
    elif --format json:
        raw
    else:
        drop /^[-]+$/
        squeeze-columns

*:
    if exit failed:
        raw
    elif --format json:
        raw
    else:
        drop-compose-spam
        head-auto-marked

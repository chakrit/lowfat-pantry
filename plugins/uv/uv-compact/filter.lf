#!/usr/bin/env lowfat-filter
# uv-compact — uv keys filter selection on the command word, so `uv run pytest`
# / `uvx ruff` / `uv tool run …` never reach pytest-compact/ruff-compact (those
# claim `pytest`/`ruff`, not `uv`). This filter unwraps the runner prefix, detects
# the wrapped tool from $args, and hands the stream to that tool's own filter; it
# also compacts uv's own resolver/install noise and caps arbitrary `uv run <prog>`.
#
# No copies: the wrapped tool's compaction is *delegated* to the real plugin by
# re-invoking `lowfat filter` on it, so pytest-compact and ruff-compact stay the
# single source of truth and cannot drift out from under this file. When the
# wrapped plugin isn't installed, the stream falls back to a marked cap rather
# than a stale duplicate of its logic. The remaining ask upstream is
# wrapper-unwrap, which would retire this filter's dispatch entirely — see the
# "Wrapper commands" section in docs/spec/pantry-plugin-backlog.md.
# env: $sub $level $exit $args

include ../../lib/truncation.lf

define uv-dispatch:
    shell: |
        # --- unwrap the runner prefix -------------------------------------------
        # uv's own subcommands; anything else in arg0 is the wrapped tool, e.g.
        # `uvx ruff` where arg0 is `ruff`.
        set -- $args
        wrapped=1
        case "${1:-}" in
            run) shift ;;
            tool)
                if [ "${2:-}" = run ]; then shift 2; else wrapped=0; fi
                ;;
            sync|lock|add|remove|pip|export|venv|build|init|python|tree|cache|self|publish|version|help)
                wrapped=0
                ;;
            "") wrapped=0 ;;
        esac

        # --- resolve the wrapped tool -------------------------------------------
        # uv-run options taking a separate-token value must not have that value
        # mistaken for the tool (`uv run --with httpx pytest`). Glued forms
        # (--with=httpx, -p3.12) are single tokens, caught by the `-` skip.
        tool=
        if [ "$wrapped" = 1 ]; then
            rest=$*
            while [ $# -gt 0 ]; do
                case "$1" in
                    --with|--with-requirements|--with-editable|-p|--python|--directory|--project|--index|--default-index|--extra-index-url|--index-url|-c|--constraint|--override|--resolution|--prerelease|--index-strategy|--keyring-provider|--refresh-package|--no-binary-package|--only-binary-package|--cache-dir|--config-file|--config-setting|--exclude-newer)
                        shift 2 || shift
                        continue
                        ;;
                    -*) shift; continue ;;
                    *) tool=$1; break ;;
                esac
            done

            # python -m pytest -> pytest
            case "$tool" in
                python|python3)
                    case " $rest " in
                        *" -m "*) tool=${rest#*-m } ; tool=${tool%% *} ;;
                    esac
                    ;;
            esac
            tool=${tool##*/}
        fi

        # --- delegate to the wrapped tool's own filter ---------------------------
        # The plugin tree is laid out the same in the pantry source and in the
        # lowfat home, so one probe list covers dev checkouts and installs alike.
        delegate() {
            for root in "${LOWFAT_HOME:-}" "$HOME/.lowfat" "$HOME/.config/lowfat" "$PWD"; do
                [ -n "$root" ] || continue
                target="$root/plugins/$1/$1-compact/filter.lf"
                [ -f "$target" ] || continue

                shift
                exec lowfat filter "$target" --sub="${1%% *}" --args="$1" \
                    --exit="${exit:-0}" --level="${level:-full}"
            done
            return 1
        }

        # --- uv's own resolver/install output ------------------------------------
        uv_native() {
            # invariant 1: `uv pip list --format json` is machine output -> raw.
            case " $args " in
                *" --format json "*|*" --format=json "*) cat; exit 0 ;;
            esac

            case "${level:-full}" in
                ultra) limit=15 ;;
                lite)  limit=60 ;;
                *)     limit=30 ;;
            esac

            buf=$(mktemp)
            trap 'rm -f "$buf"' EXIT
            cat > "$buf"

            # case folding spelled out per letter — BSD sed/grep ERE has no (?i)
            noise='[Ee][Rr][Rr][Oo][Rr]|[Ww][Aa][Rr][Nn][Ii][Nn][Gg]|[Ff][Aa][Ii][Ll][Ee][Dd]|[Pp][Aa][Nn][Ii][Cc]'
            keep=$(grep -E "^[[:blank:]]*(Resolved|Installed|Audited|Prepared|Uninstalled|Removed|Updated|Built|Downloaded) |^[[:blank:]]*[+-] [^[:blank:]]|$noise" "$buf")

            if [ -n "$keep" ]; then
                shown=$(printf '%s\n' "$keep" | grep -c '')
                printf '%s\n' "$keep" | head -n "$limit"
                [ "$shown" -gt "$limit" ] && printf '[lowfat] +%d lines dropped (level=%s) -- output truncated, re-run raw for the full list\n' "$((shown - limit))" "${level:-full}"
            elif [ "${exit:-0}" = "0" ]; then
                printf 'uv %s: ok\n' "${1:-}" | sed -E 's/ +:/:/'
            else
                total=$(grep -c '' < "$buf")
                head -n "$limit" < "$buf"
                [ "$total" -gt "$limit" ] && printf '[lowfat] +%d lines dropped (level=%s) -- output truncated, re-run raw for the full list\n' "$((total - limit))" "${level:-full}"
            fi
            exit 0
        }

        # --- arbitrary `uv run <prog>`: cap only, never keyword-filter ------------
        # a silently capped program body looks complete; announce the cap so the
        # agent knows output was truncated (the curl/gem/rake/cap convention).
        generic() {
            case "${level:-full}" in
                ultra) limit=20 ;;
                lite)  limit=80 ;;
                *)     limit=40 ;;
            esac

            buf=$(mktemp)
            trap 'rm -f "$buf"' EXIT
            cat > "$buf"

            total=$(grep -c '' < "$buf")
            head -n "$limit" < "$buf"
            [ "$total" -gt "$limit" ] && printf '[lowfat] +%d lines dropped (level=%s) -- output truncated, re-run raw for the full list\n' "$((total - limit))" "${level:-full}"
            exit 0
        }

        if [ "$wrapped" = 0 ]; then
            set -- $args
            uv_native "${1:-}"
        fi

        case "$tool" in
            pytest|ruff) delegate "$tool" "${rest#"$tool" }" || generic ;;
            *) generic ;;
        esac

*:
    uv-dispatch

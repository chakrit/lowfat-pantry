#!/usr/bin/env lowfat-filter
# diff-compact — preserve hunk headers and changed lines; exit 1 is meaningful output.
# env: $sub $level $exit $args

define compact-diff(limit):
    shell: |
        if [ "${exit:-0}" = "2" ]; then
            cat
            exit 0
        fi

        buf=$(mktemp)
        trap 'rm -f "$buf"' EXIT
        cat > "$buf"

        # Changed lines and hunk headers share the main budget; surrounding
        # context gets its own small allowance, and none at ultra.
        sed -E '
        /^(--- |\+\+\+ |@@ )/{s/^/D/;b
        }
        /^[+-]/{s/^/D/;b
        }
        /^[[:space:]]*$/{s/^/B/;b
        }
        s/^/C/' < "$buf" | {
            kept=0
            context=0
            dropped=0
            emitted=0
            while IFS= read -r tagged || [ -n "$tagged" ]; do
                line=${tagged#?}
                case $tagged in
                    D*)
                        if [ "$kept" -lt $1 ]; then
                            printf '%s\n' "$line"
                            kept=$((kept + 1))
                            emitted=1
                        else
                            dropped=$((dropped + 1))
                        fi
                        ;;
                    C*)
                        [ "${level:-full}" = "ultra" ] && continue
                        if [ "$context" -lt 6 ]; then
                            printf '%s\n' "$line"
                            context=$((context + 1))
                            emitted=1
                        fi
                        ;;
                esac
            done

            # Nothing matched — an unrecognized shape must not read as silence.
            if [ "$emitted" = 0 ]; then
                total=$(grep -c '' < "$buf")
                [ "$total" -gt $1 ] && printf '[lowfat] +%d earlier lines dropped (level=%s) -- output truncated, re-run raw for the full list\n' "$((total - $1))" "${level:-full}"
                tail -n $1 < "$buf"
            fi

            [ "$dropped" -gt 0 ] && printf '[lowfat] +%d lines dropped (level=%s) -- output truncated, re-run raw for the full list\n' "$dropped" "${level:-full}"
        }
        exit 0

*:
    match level:
        ultra: compact-diff 20
        full:  compact-diff 45
        lite:  compact-diff 90


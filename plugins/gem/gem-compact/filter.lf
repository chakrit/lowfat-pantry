#!/usr/bin/env lowfat-filter
# gem-compact — install/update: keep the "Successfully installed" / "N gems
# installed" state lines and any error, drop documentation/fetch chatter; on
# failure keep the ERROR block. list/which/env: cap rows with a recovery hint.
# env: $sub $level $exit $args

define cap(limit):
    python: |
        import sys

        lines = sys.stdin.read().splitlines()

        kept = lines[:$1]
        if len(lines) > len(kept):
            kept.append(f"... ({len(lines)} lines total)")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

install|update:
    match exit:
        failed:
            keep /(ERROR|error:|Could not|Unable|conflict|Failed|alternatives)/
            head 30
            or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 30 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-30))"; fi; printf '%s\n' "$s" | tail -30
        else:
            keep /(Successfully installed|gems? installed|gems? updated|ERROR|error|warning|Building native)/
            head 20
            or "gem: ok"

list|which|env|sources|contents:
    match level:
        ultra: cap 20
        lite:  cap 300
        else:  cap 80

*:
    match level:
        ultra: cap 20
        lite:  cap 200
        else:  cap 60

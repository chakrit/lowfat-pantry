#!/usr/bin/env lowfat-filter
# pnpm-compact - keep pnpm summaries and diagnostics, trim progress.
# env: $sub $level $exit $args
#
# `--json` (`pnpm ls`/`audit`/`outdated`/`licenses --json`) is machine output —
# pass byte-exact (invariant 1). Without the guard `head auto` truncates it
# (a 24-line `ls --json` lost 9 lines at ultra).

# `head auto` cuts without a trace, so a truncated stream is indistinguishable from a
# genuinely short one and the reader acts on a confident wrong answer (issue #1). Mirrors
# `head auto`'s level limits (ultra 15 / full 30 / lite 60) and names what it dropped.
define head-auto-marked:
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        limit = {"ultra": 15, "lite": 60}.get(level, 30)
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:limit]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define compact-pnpm-install(limit):
    drop /^Progress: /
    drop /^Resolving: /
    keep /^(WARN|ERR_PNPM|Packages:[[:space:]]|Done in |dependencies:|devDependencies:|[[:space:]]*[+][[:space:]])/
    shell: head -$1
    or-shell: s=$(grep -E '[^[:space:]]'); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt $1 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-$1))"; fi; printf '%s\n' "$s" | tail -$1

# cap that announces itself — a silently head-capped script body looks complete;
# the hint tells the agent output was truncated.
define cap(limit):
    python: |
        import sys

        lines = sys.stdin.read().splitlines()

        kept = lines[:$1]
        if len(lines) > len(kept):
            kept.append(f"... ({len(lines)} lines total)")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

install|i:
    if exit failed:
        raw
    elif --json:
        raw
    else:
        match level:
            ultra: compact-pnpm-install 18
            full:  compact-pnpm-install 35
            lite:  compact-pnpm-install 70

run|test:
    if exit failed:
        raw
    else:
        match level:
            ultra: cap 30
            full:  cap 80
            lite:  cap 160

*:
    if exit failed:
        raw
    elif --json:
        raw
    else:
        head-auto-marked

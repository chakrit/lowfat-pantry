#!/usr/bin/env lowfat-filter
# kubectl-compact — preserve cluster signal while capping log verbosity.
# `get` is an inventory listing: every row is load-bearing, so rows are never capped,
# only column-squeezed (invariant 6).
# env: $sub $level $exit $args
#
# `-o json` / `-o yaml` is machine output — pass byte-exact (invariant 1).
# Without the guard, squeeze-columns/describe shred JSON/YAML. The
# guard repeats per compacting rule because `.lf` has no top-level pre-filter
# and macros can't wrap a cascade. (`-o jsonpath`/`go-template`/`custom-columns`
# emit caller-formatted text — residual risk, not yet guarded.)

# `head auto` cuts without a trace, so a truncated stream is indistinguishable from a
# genuinely short one and the reader acts on a confident wrong answer (issue #1). Mirrors
# `head auto`'s level limits (ultra 15 / full 30 / lite 60) and names what it dropped.
# Inventory listings are one load-bearing row per line: nothing is redundant, so no row
# may be dropped (invariant 6). Column padding is the only slack — squeezing runs of
# whitespace saves tokens without losing an item.
define squeeze-columns:
    python: |
        import re, sys

        for line in sys.stdin.read().rstrip("\n").splitlines():
            print(re.sub(r"[ \t]{2,}", " ", line))

define head-auto-marked:
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        limit = {"ultra": 15, "lite": 60}.get(level, 30)
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:limit]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define compact-describe(limit):
    python: |
        import os, re, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().splitlines()

        out, events, in_events = [], 0, False
        for line in lines:
            if re.match(r"^(Name:|Namespace:|Status:|Controlled By:|Events:)", line):
                out.append(line)
                if line.startswith("Events:"):
                    in_events = True
                continue
            if in_events and (re.match(r"^  Type[ \t]+Reason", line) or line.startswith("  ----")):
                out.append(line)
                continue
            if in_events:
                if line.strip():
                    if events < $1:
                        out.append(line)
                        events += 1
                    continue
                continue
            if level != "ultra" and re.match(r"^(Labels:|Annotations:|Containers:|Conditions:|Replicas:|StrategyType:)", line):
                out.append(line)

        sys.stdout.write("\n".join(out) + "\n" if out else "")

get:
    if exit failed:
        raw
    elif -o json:
        raw
    elif -o yaml:
        raw
    else:
        squeeze-columns

describe:
    if exit failed:
        raw
    elif -o json:
        raw
    elif -o yaml:
        raw
    else:
        match level:
            ultra: compact-describe 8
            full:  compact-describe 24
            lite:  compact-describe 48

logs, ultra:
    if exit failed:
        raw
    else:
        tail 15

logs, full:
    if exit failed:
        raw
    else:
        tail 30

logs:
    if exit failed:
        raw
    else:
        tail 60

apply|rollout:
    if exit failed:
        raw
    elif -o json:
        raw
    elif -o yaml:
        raw
    else:
        keep /^([[:alnum:]._\/-]+ (created|configured|unchanged|deleted)|deployment ".+" successfully|Waiting for|rollout status|error:)/
        head auto
        or-shell: s=$(grep -E '[^[:space:]]'); n=$(printf '%s\n' "$s" | wc -l); printf '%s\n' "$s" | head -30; if [ "$n" -gt 30 ]; then printf '[lowfat] +%d lines dropped -- re-run raw for the full list\n' "$((n-30))"; fi

*:
    if exit failed:
        raw
    elif -o json:
        raw
    elif -o yaml:
        raw
    else:
        head-auto-marked


#!/usr/bin/env lowfat-filter
# black-compact — compact Black (Python formatter) output for LLM contexts.
# env: $sub $level $exit $args
#
# Black writes status to stderr: `reformatted <file>` / `would reformat <file>`
# per file, a celebratory/sad emoji line, and a `N files reformatted, M left
# unchanged` summary. exit 0 = nothing to do (or reformatted), exit 1 = --check
# found files needing formatting, exit 123 = internal/parse error. The bloat is
# the per-file list; the signal is which files + the summary. ultra keeps just
# those; `or-shell: head` guards against hiding a parse error.

# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

*:
    if exit failed:
        match level:
            ultra:
                keep /^(would reformat|reformatted|error:|cannot |[0-9]+ files? )/
                head-marked 30
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); printf '%s\n' "$s" | head -30; if [ "$n" -gt 30 ]; then printf '[lowfat] +%d lines dropped -- re-run raw for the full list\n' "$((n-30))"; fi
            lite:
                head-marked 200
            else:
                head-marked 80
    else:
        match level:
            ultra:
                keep /^(reformatted|[0-9]+ files? )/
                head-marked 20
                or "black: all files already formatted"
            lite:
                head-marked 200
            else:
                head-marked 60

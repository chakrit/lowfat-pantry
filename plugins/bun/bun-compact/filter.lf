#!/usr/bin/env lowfat-filter
# bun-compact — compact Bun output for LLM contexts.
# env: $sub $level $exit $args
#
# install/add: the bloat is the per-package `+ pkg@ver` list; the signal is the
# `N packages installed` summary + warnings/errors. test: keep failing specs
# (`✗`/`(fail)`) + the pass/fail tallies + `Ran N tests`, drop the `✓` passing
# lines at ultra. run/build/x: the body is the program's own output — never
# keyword-filter it; cap, and tail on failure (errors land at the end).

# cap that announces itself — a silently head-capped program body looks
# complete; the hint tells the agent output was truncated.
# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define cap(limit):
    python: |
        import sys

        lines = sys.stdin.read().splitlines()

        kept = lines[:$1]
        if len(lines) > len(kept):
            kept.append(f"... ({len(lines)} lines total)")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

# ── install / dependency mutation ─────────────────────────────────────────
install|add|remove|update|pm|link|unlink:
    if exit failed:
        match level:
            ultra: tail 30
            lite:  tail 200
            else:  tail 60
    else:
        match level:
            ultra:
                keep /(packages installed|Saved lockfile|error|warn|panic|^bun (install|add|remove))/
                tail 20
                or "bun: ok"
            lite:
                head 200
            else:
                head 60

# ── test — keep failures + tallies, drop passing specs ────────────────────
test:
    match level:
        ultra:
            keep /(✗|✘|✕|\(fail\)|error:|panic|[0-9]+ (pass|fail|error|skip)|Ran [0-9]+ test|\.test\.|^bun test)/
            tail 30
            or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 30 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-30))"; fi; printf '%s\n' "$s" | tail -30
        lite:
            head 200
        else:
            head 80

# ── run / build / x — program output; never keyword-filter ────────────────
run|build|x|exec:
    if exit failed:
        match level:
            ultra: tail 40
            lite:  tail 200
            else:  tail 80
    else:
        match level:
            ultra: cap 25
            lite:  cap 200
            else:  cap 60

*:
    if exit failed:
        raw
    else:
        head-marked 40

#!/usr/bin/env lowfat-filter
# go-compact - keep Go diagnostics and test failures while dropping routine test noise.
# env: $sub $level $exit $args
#
# `-json` is machine output — `go test -json` (ndjson), `go list -json`,
# `go mod … -json`, `go vet -json`, `go build -json` (1.24+) — pass byte-exact
# (invariant 1). Without the guard `go test -json` on a passing run collapses to
# "go test: ok"; list/mod/* truncate the JSON. The guard repeats per compacting
# rule because `.lf` has no top-level pre-filter.

# `head auto` cuts without a trace, so a truncated stream is indistinguishable from a
# genuinely short one and the reader acts on a confident wrong answer (issue #1). Mirrors
# `head auto`'s level limits (ultra 15 / full 30 / lite 60) and names what it dropped.
define head-auto-marked:
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        limit = {"ultra": 15, "lite": 60}.get(level, 30)
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:limit]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

build:
    if exit failed:
        raw
    elif -json:
        raw
    else:
        match level:
            ultra: head 20
            full:  head 40
            lite:  head 80

test:
    if -json:
        raw
    elif exit failed:
        match level:
            ultra:
                keep /^(--- FAIL|FAIL|panic:|[[:space:]]+panic|[[:space:]]+.+\.go:[0-9]+:|[[:space:]]+Error Trace:|[[:space:]]+Error:|ok[[:space:]]|[?][[:space:]]|# )/
                head 40
                or-shell: s=$(grep -E '[^[:space:]]'); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 40 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-40))"; fi; printf '%s\n' "$s" | tail -40
            full:
                drop /^=== RUN /
                drop /^--- PASS: /
                drop /^PASS$/
                head 120
            lite:
                drop /^=== RUN /
                drop /^--- PASS: /
                head 220
    else:
        match level:
            ultra:
                keep /^(ok[[:space:]]|PASS$|FAIL$|# )/
                head 25
                or "go test: ok"
            full:
                drop /^=== RUN /
                drop /^--- PASS: /
                head 60
            lite:
                drop /^=== RUN /
                head 120

vet:
    if exit failed:
        raw
    elif -json:
        raw
    else:
        keep /^(.+\.go:[0-9]+:[0-9]+:|# )/
        head auto
        or "go vet: ok"

mod:
    if exit failed:
        raw
    elif -json:
        raw
    else:
        match level:
            ultra: head 15
            full:  head 30
            lite:  head 60

*:
    if exit failed:
        raw
    elif -json:
        raw
    else:
        head-auto-marked

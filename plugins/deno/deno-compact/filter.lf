#!/usr/bin/env lowfat-filter
# deno-compact — compact Deno output for LLM contexts.
# env: $sub $level $exit $args
#
# test: keep `FAILED`, the `failures:` block, `test result:` summary, and
# assertion/error lines; drop the per-test `... ok` passing noise. check/lint:
# keep the diagnostics (errors with file:line). run/task: the body is the
# program's own output — never keyword-filter; cap, tail on failure.
#
# `--json` (`deno lint --json`, `deno info --json`) is machine output — pass
# byte-exact (invariant 1). Without the guard `head` truncates it (a 99-line
# `lint --json` fell to 40 at ultra). Guarded in check|lint and `*`.

# cap that announces itself — a silently head-capped program body looks
# complete; the hint tells the agent output was truncated.
# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define cap(limit):
    python: |
        import sys

        lines = sys.stdin.read().splitlines()

        kept = lines[:$1]
        if len(lines) > len(kept):
            kept.append(f"... ({len(lines)} lines total)")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

# ── test / bench — keep failures + result, drop passing noise ─────────────
test|bench:
    match level:
        ultra:
            keep /(FAILED|error:|AssertionError|^failures:|^test result:|panic|^running [0-9]+ test)/
            head 30
            or "deno test: ok"
        lite:
            drop /\.\.\. ok/
            head 200
        else:
            drop /\.\.\. ok/
            head 60

# ── check / lint — diagnostics; cap, raw-tail fallback ────────────────────
check|lint:
    if --json:
        raw
    elif exit failed:
        match level:
            ultra:
                head 40
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 40 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-40))"; fi; printf '%s\n' "$s" | tail -40
            lite:
                head 200
            else:
                head 80
    else:
        head 5
        or "deno: no issues"

# ── run / task / eval — program output; never keyword-filter ──────────────
run|task|eval|repl|serve:
    if exit failed:
        match level:
            ultra: tail 40
            lite:  tail 200
            else:  tail 80
    else:
        match level:
            ultra: cap 25
            lite:  cap 200
            else:  cap 60

*:
    if exit failed:
        raw
    elif --json:
        raw
    else:
        head-marked 40

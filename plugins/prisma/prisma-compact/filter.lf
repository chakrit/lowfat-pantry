#!/usr/bin/env lowfat-filter
# prisma-compact - strip banner/box art, keep migration and generation signal.
# env: $sub $level $exit $args

# `head auto` cuts without a trace, so a truncated stream is indistinguishable from a
# genuinely short one and the reader acts on a confident wrong answer (issue #1). Mirrors
# `head auto`'s level limits (ultra 15 / full 30 / lite 60) and names what it dropped.
define head-auto-marked:
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        limit = {"ultra": 15, "lite": 60}.get(level, 30)
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:limit]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define strip-prisma-noise:
    drop /^Prisma schema loaded from /
    drop /^Datasource "/
    drop /^┌/
    drop /^│/
    drop /^└/
    drop /^╭/
    drop /^╰/
    drop /^[- ]*Prisma/

migrate|generate|db:
    if exit failed:
        raw
    else:
        match level:
            ultra:
                strip-prisma-noise
                # keep: migration progress/apply confirmations, client-generation
                # success markers, and Error: lines
                keep /(✔ Generated|Applying migration|Migration .* applied|Your database is now in sync|The following migration|Generated Prisma Client|Error:)/
                head 35
                or "prisma: ok"
            lite:
                strip-prisma-noise
                head 120
            else:
                strip-prisma-noise
                head 60

*:
    if exit failed:
        raw
    else:
        head-auto-marked

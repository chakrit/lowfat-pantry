#!/usr/bin/env lowfat-filter
# npm-compact - drop install progress, keep summaries, warnings, audit, and raw failures.
# env: $sub $level $exit $args

include ../../lib/truncation.lf

define compact-npm-install(limit):
    drop /^npm notice /
    drop /^npm http /
    drop /^npm timing /
    drop /^npm verb /
    drop /^npm sill /
    # keep: package-count summaries (added/removed/changed/audited), funding +
    # vulnerability totals, and every npm warn/error line
    keep /^(added [0-9]+ packages|removed [0-9]+ packages|changed [0-9]+ packages|audited [0-9]+ packages|[0-9]+ packages are looking for funding|found [0-9]+ vulnerabilities|[0-9]+ .+ vulnerabilities|[0-9]+ vulnerabilities|npm warn|npm error|npm ERR!)/
    # `head-marked $1` cannot be written: `$N` reaches only shell:/or-shell: bodies,
    # never an op argument, so the limit has to travel inside the body.
    shell: |
        body=$(cat)
        [ -n "$body" ] || exit 0

        total=$(printf '%s\n' "$body" | grep -c '')
        printf '%s\n' "$body" | head -n $1

        [ "$total" -gt $1 ] && printf '[lowfat] +%d lines dropped (level=%s) -- output truncated, re-run raw for the full list\n' "$((total - $1))" "${level:-full}"
        exit 0
    or-shell: s=$(grep -E '[^[:space:]]'); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt $1 ]; then printf '[lowfat] +%d earlier lines dropped (level=%s) -- output truncated, re-run raw for the full list\n' "$((n-$1))" "${level:-full}"; fi; printf '%s\n' "$s" | tail -$1

# --json is machine output on any subcommand — pass byte-exact (invariant 1).
install|i|ci:
    if --json:
        raw
    elif exit failed:
        raw
    else:
        match level:
            ultra: compact-npm-install 15
            full:  compact-npm-install 30
            lite:  compact-npm-install 60

run|test:
    if --json:
        raw
    elif exit failed:
        raw
    else:
        match level:
            ultra: head-marked 30
            full:  head-marked 80
            lite:  head-marked 160

*:
    if --json:
        raw
    elif exit failed:
        raw
    else:
        head-auto-marked

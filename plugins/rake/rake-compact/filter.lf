#!/usr/bin/env lowfat-filter
# rake-compact — a task's output is the task's own (passthrough) body, so on
# success only cap it. On failure keep "rake aborted!", the error message and
# the "Tasks:" trailer, dropping the Ruby backtrace frames.
# env: $sub $level $exit $args

include ../../lib/truncation.lf

*:
    if exit failed:
        match level:
            ultra:
                drop /:[0-9]+:in /
                head-marked 6
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 20 ]; then printf '[lowfat] +%d earlier lines dropped (level=%s) -- output truncated, re-run raw for the full list\n' "$((n-20))" "${level:-full}"; fi; printf '%s\n' "$s" | tail -20
            lite:
                drop /:[0-9]+:in /
                head-marked 60
            full:
                drop /:[0-9]+:in /
                head-marked 30
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 20 ]; then printf '[lowfat] +%d earlier lines dropped (level=%s) -- output truncated, re-run raw for the full list\n' "$((n-20))" "${level:-full}"; fi; printf '%s\n' "$s" | tail -20
    else:
        match level:
            ultra: cap 30
            lite:  cap 300
            else:  cap 100

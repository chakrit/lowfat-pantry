#!/usr/bin/env lowfat-filter
# rake-compact — a task's output is the task's own (passthrough) body, so on
# success only cap it. On failure keep "rake aborted!", the error message and
# the "Tasks:" trailer, dropping the Ruby backtrace frames.
# env: $sub $level $exit $args

# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define cap(limit):
    python: |
        import sys

        lines = sys.stdin.read().splitlines()

        kept = lines[:$1]
        if len(lines) > len(kept):
            kept.append(f"... ({len(lines)} lines total)")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

*:
    if exit failed:
        match level:
            ultra:
                drop /:[0-9]+:in /
                head-marked 6
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 20 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-20))"; fi; printf '%s\n' "$s" | tail -20
            lite:
                drop /:[0-9]+:in /
                head-marked 60
            full:
                drop /:[0-9]+:in /
                head-marked 30
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 20 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-20))"; fi; printf '%s\n' "$s" | tail -20
    else:
        match level:
            ultra: cap 30
            lite:  cap 300
            else:  cap 100

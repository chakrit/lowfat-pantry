#!/usr/bin/env lowfat-filter
# aws-compact - byte-preserve JSON/default output; compact table/text only.
# env: $sub $level $exit $args

define compact-aws-table(limit):
    python: |
        import re, sys

        lines = sys.stdin.read().splitlines()

        out = []
        for line in lines:
            if re.match(r"^-+$|^[|][+-]+[|]$|^[+][-+]+[+]$", line):
                continue
            if line.startswith("|"):
                if len(out) < $1:
                    cell = re.sub(r"^[|][ \t]*", "", line)
                    cell = re.sub(r"[ \t]*[|][ \t]*", " ", cell)
                    out.append(re.sub(r"[ \t]+$", "", cell))
                continue
            if line.strip() and len(out) < $1:
                out.append(re.sub(r"[ \t][ \t]+", " ", line))

        sys.stdout.write("\n".join(out) + "\n" if out else "")

*:
    if exit failed:
        raw
    elif --output table:
        match level:
            ultra: compact-aws-table 15
            full:  compact-aws-table 30
            lite:  compact-aws-table 60
    elif --output text:
        match level:
            ultra: compact-aws-table 20
            full:  compact-aws-table 40
            lite:  compact-aws-table 80
    else:
        raw

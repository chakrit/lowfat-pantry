#!/usr/bin/env lowfat-filter
# az — output shape is decided by flags, not subcommands: default success
# output is JSON (must pass byte-exact), errors are terse ERROR: one-liners,
# and the real bloat is --help (1k+ lines for `az vm create --help`). Help
# keeps section headers + flag-name lines (4-space indent) and the Examples
# tail, dropping the column-wrapped description text (8+-space indent).

# `head auto` cuts without a trace, so a truncated stream is indistinguishable from a
# genuinely short one and the reader acts on a confident wrong answer (issue #1). Mirrors
# `head auto`'s level limits (ultra 15 / full 30 / lite 60) and names what it dropped.
define head-auto-marked:
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        limit = {"ultra": 15, "lite": 60}.get(level, 30)
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:limit]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define compact-help:
    split /^Examples/
    pre:
        keep /^([A-Z]|    [^ ])/
        head-auto-marked
    post:
        head-auto-marked

*:
    if --help:
        compact-help
    elif -h:
        compact-help
    elif exit failed:
        raw
    elif -o table:
        head-auto-marked
    elif --output table:
        head-auto-marked
    elif -o tsv:
        head-auto-marked
    elif --output tsv:
        head-auto-marked
    else:
        raw

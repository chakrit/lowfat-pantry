#!/usr/bin/env lowfat-filter
# rg-compact — compact ripgrep output for LLM contexts.
# env: $sub $level $exit $args
#
# ripgrep exit codes (same family as grep):
#   0 → matches found     (typical signal)
#   1 → no matches        (empty output; not a real failure)
#   2 → actual error      (bad regex, unreadable path — preserve stderr)
# `if exit failed` covers both 1 and 2: `raw` is empty for 1 (filled by `or`)
# and carries the error text for 2.
#
# Piped under lowfat (non-TTY), ripgrep defaults to --no-heading, emitting one
# `path:line:text` match per line. Recursive match lists are the bloat we cap;
# tighter than grep since rg searches whole trees by default.
#
# `--json` emits an ndjson event stream (begin/match/end/summary) — pass
# byte-exact (invariant 1). Without the guard `head N` truncates it mid-stream
# (dropping the summary record) into corrupt ndjson. --json is checked first so
# it raws on any exit (a no-match run still emits a valid summary record).

# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

*:
    if --json:
        raw
    elif exit failed:
        raw
        or "rg: no matches"
    else:
        match level:
            ultra: head-marked 20
            lite:  head-marked 200
            else:  head-marked 60

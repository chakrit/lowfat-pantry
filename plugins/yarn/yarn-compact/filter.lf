#!/usr/bin/env lowfat-filter
# yarn-compact — compact Yarn output for LLM contexts.
# env: $sub $level $exit $args
#
# install/add: the bloat is the `[n/4] Resolving/Fetching/Linking…` step lines
# and per-package chatter; the signal is warnings, errors, `success Saved
# lockfile`, and `Done in Xs`. run/test/build: the body is the invoked script's
# own output — we must NOT keyword-filter it (would hide results), only drop the
# `$ <cmd>` echo line and cap; on failure we tail (errors land at the end).

# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define drop-steps:
    drop /^\[[0-9]+\/[0-9]+\] /
    drop /^(\$ |info |verbose )/

# cap that announces itself — a silently head-capped script body looks complete;
# the hint tells the agent output was truncated.
define cap(limit):
    python: |
        import sys

        lines = sys.stdin.read().splitlines()

        kept = lines[:$1]
        if len(lines) > len(kept):
            kept.append(f"... ({len(lines)} lines total)")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

# ── install / dependency mutation ─────────────────────────────────────────
install|add|remove|upgrade|why|dedupe:
    if exit failed:
        match level:
            ultra: tail 30
            lite:  head 200
            else:  tail 60
    else:
        match level:
            ultra:
                drop-steps
                keep /^(warning|error|success|Done in|➤|✓|✘)/
                head 20
                or "yarn: ok"
            lite:
                drop-steps
                head 200
            else:
                drop-steps
                head 60

# ── run / test / build / exec — script output; never keyword-filter ───────
run|test|build|exec|dlx|node:
    if exit failed:
        match level:
            ultra: tail 40
            lite:  tail 200
            else:  tail 80
    else:
        match level:
            ultra:
                drop-steps
                cap 25
            lite:
                drop-steps
                cap 200
            else:
                drop-steps
                cap 60

*:
    if exit failed:
        raw
    else:
        head-marked 40

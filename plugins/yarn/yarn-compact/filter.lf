#!/usr/bin/env lowfat-filter
# yarn-compact — compact Yarn output for LLM contexts.
# env: $sub $level $exit $args
#
# install/add: the bloat is the `[n/4] Resolving/Fetching/Linking…` step lines
# and per-package chatter; the signal is warnings, errors, `success Saved
# lockfile`, and `Done in Xs`. run/test/build: the body is the invoked script's
# own output — we must NOT keyword-filter it (would hide results), only drop the
# `$ <cmd>` echo line and cap; on failure we tail (errors land at the end).

include ../../lib/truncation.lf

define drop-steps:
    drop /^\[[0-9]+\/[0-9]+\] /
    drop /^(\$ |info |verbose )/

# yarn reports its own crashes with a trace through its bundled, minified cli.js
# and node's internals. The frames name no file the reader has, so ten of the
# fifteen lines of a failed install say nothing.
define drop-frames:
    drop /^[[:space:]]+at [A-Za-z_$<]/

# ── install / dependency mutation ─────────────────────────────────────────
# A failed `yarn install` puts its verdict at the TOP: `error <reason>` on line 4 of 15,
# then a ten-frame stack trace, then the `info Visit …` footer. Tailing here cuts the one
# line that says what went wrong and keeps the frames nobody reads.
install|add|remove|upgrade|why|dedupe:
    if exit failed:
        match level:
            ultra:
                drop-frames
                head-marked 30
            lite:
                drop-frames
                head-marked 200
            else:
                drop-frames
                head-marked 60
    else:
        match level:
            ultra:
                drop-steps
                keep /^(warning|error|success|Done in|➤|✓|✘)/
                head-marked 20
                or "yarn: ok"
            lite:
                drop-steps
                head-marked 200
            else:
                drop-steps
                head-marked 60
# ── run / test / build / exec — script output; never keyword-filter ───────
run|test|build|exec|dlx|node:
    if exit failed:
        match level:
            ultra: tail-marked 40
            lite:  tail-marked 200
            else:  tail-marked 80
    else:
        match level:
            ultra:
                drop-steps
                cap 25
            lite:
                drop-steps
                cap 200
            else:
                drop-steps
                cap 60

*:
    if exit failed:
        raw
    else:
        head-marked 40

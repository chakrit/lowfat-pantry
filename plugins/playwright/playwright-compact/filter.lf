#!/usr/bin/env lowfat-filter
# playwright-compact - keep failing specs, diagnostics, and summary.
# env: $sub $level $exit $args
#
# `--reporter=json`/`junit` is machine output — pass byte-exact (invariant 1).
# Without the guard the tail-cap truncates the JSON report (a 177-line report
# fell to 100 at ultra). Guarded value-specifically so the human reporters
# (list/line/dot) still compact. Residual: a reporter set in playwright.config
# isn't visible here, and `blob`/`github` formats aren't guarded.

# `head auto` cuts without a trace, so a truncated stream is indistinguishable from a
# genuinely short one and the reader acts on a confident wrong answer (issue #1). Mirrors
# `head auto`'s level limits (ultra 15 / full 30 / lite 60) and names what it dropped.
define head-auto-marked:
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        limit = {"ultra": 15, "lite": 60}.get(level, 30)
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:limit]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

test:
    if --reporter json:
        raw
    elif --reporter junit:
        raw
    elif exit failed:
        match level:
            ultra:
                drop /^[[:space:]]*[✓·.][[:space:]]/
                drop /^[[:space:]]*[0-9]+ passed /
                tail 100
            lite:
                drop /^[[:space:]]*[✓·.][[:space:]]/
                tail 240
            else:
                drop /^[[:space:]]*[✓·.][[:space:]]/
                tail 160
    else:
        match level:
            ultra:
                drop /^[[:space:]]*[✓·.][[:space:]]/
                keep /(Running [0-9]+ tests|[0-9]+ passed|[0-9]+ failed|[0-9]+ flaky|[0-9]+ skipped)/
                tail 20
                or "playwright: passed"
            lite:
                drop /^[[:space:]]*[✓·.][[:space:]]/
                tail 120
            else:
                drop /^[[:space:]]*[✓·.][[:space:]]/
                tail 60

*:
    if exit failed:
        raw
    else:
        head-auto-marked

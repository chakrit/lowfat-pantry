#!/usr/bin/env lowfat-filter
# tsc-compact — compact TypeScript compiler diagnostics for LLM contexts.
# env: $sub $level $exit $args
#
# tsc has no subcommands; it exits 0 on success (often with NO output under
# --noEmit) and non-zero when type errors exist. The bloat is the pretty
# code-frame: each `error TSxxxx` is followed by a blank line, the offending
# source line, and a `~~~~` underline. The signal is the `path:line:col - error
# TSxxxx: message` lines, the `Found N errors` summary, and the per-file
# `Errors  Files` table (tsc --pretty). At ultra we keep just those.

# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

*:
    if exit failed:
        match level:
            ultra:
                keep /(error TS[0-9]+|^Found [0-9]+ error|^Errors  Files|^[[:space:]]*[0-9]+[[:space:]]+[^[:space:]])/
                head-marked 40
                or-shell: s=$(grep -E 'error TS[0-9]+'); n=$(printf '%s\n' "$s" | wc -l); printf '%s\n' "$s" | head -40; if [ "$n" -gt 40 ]; then printf '[lowfat] +%d lines dropped -- re-run raw for the full list\n' "$((n-40))"; fi
            lite:
                head-marked 200
            else:
                head-marked 80
    else:
        head-marked 10
        or "tsc: no errors"

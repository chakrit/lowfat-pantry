#!/usr/bin/env lowfat-filter
# mvn-compact - drop Maven transfer/plugin noise while preserving build signal.
# env: $sub $level $exit $args

# Bare `tail` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped — leading, since
# the drop happened above what survived.
define tail-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[-$1:]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.insert(0, f"[lowfat] +{dropped} earlier lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define drop-maven-noise:
    drop /^\[INFO\] (Downloading|Downloaded) /
    drop /^\[INFO\][[:space:]]+-+$/
    drop /^\[INFO\] --- /
    drop /^\[INFO\][[:space:]]+[0-9]+\/[0-9]+[[:space:]]/
    drop /^Progress \([0-9]+\): /

# A failed Maven build is exactly when extraction matters most (the [ERROR]
# buried in hundreds of transfer/plugin lines), so we DON'T raw on failure —
# the same keep/extract runs regardless of exit. `or-shell: tail` is the
# over-prune fallback when nothing matched (a crash with no [ERROR] markers).
*:
    match level:
        ultra:
            keep /^(\[ERROR\]|\[WARNING\]|Tests run: [0-9]+,|(\[INFO\] )?BUILD (SUCCESS|FAILURE)|\[INFO\] Reactor Summary|\[INFO\] [[:alnum:]._-]+[[:space:]]+\.+[[:space:]]+(SUCCESS|FAILURE))/
            tail-marked 40
            or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 40 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-40))"; fi; printf '%s\n' "$s" | tail -40
        lite:
            drop-maven-noise
            tail-marked 200
        else:
            drop-maven-noise
            tail-marked 80


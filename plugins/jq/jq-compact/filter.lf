#!/usr/bin/env lowfat-filter
# jq-compact - keep full/lite JSON byte-exact; ultra summarizes large arrays.
# env: $sub $level $exit $args

# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define ultra-json-array(limit):
    python: |
        import json
        import sys

        raw = sys.stdin.read()
        try:
            value = json.loads(raw)
        except Exception:
            sys.stdout.write(raw)
            raise SystemExit(0)

        if isinstance(value, list) and len(value) > $1:
            out = value[:$1] + [{"lowfat_truncated": "%d more elements" % (len(value) - $1)}]
            sys.stdout.write(json.dumps(out, indent=2, ensure_ascii=False))
            sys.stdout.write("\n")
        else:
            sys.stdout.write(raw)

*:
    if exit failed:
        raw
    elif -r:
        match level:
            ultra: head-marked 30
            lite:  head-marked 120
            else:  head-marked 60
    elif --raw-output:
        match level:
            ultra: head-marked 30
            lite:  head-marked 120
            else:  head-marked 60
    else:
        match level:
            ultra: ultra-json-array 12
            full:  raw
            lite:  raw

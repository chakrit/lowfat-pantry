#!/usr/bin/env lowfat-filter
# bundle-compact — install/update: collapse Fetching/Resolving chatter to the
# "Bundle complete!" verdict; on failure drop the giant "matching gems" version
# dump but keep the error. list/show: cap rows with a recovery hint. exec: the
# body is another tool's output — cap only, never keyword-filter.
# env: $sub $level $exit $args

include ../../lib/truncation.lf

install|update|add:
    match exit:
        failed:
            match level:
                ultra:
                    drop /^  \* [a-z0-9._-]+-[0-9]/
                    head-marked 20
                    or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 20 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-20))"; fi; printf '%s\n' "$s" | tail -20
                lite:
                    drop /^  \* [a-z0-9._-]+-[0-9]/
                    head-marked 200
                full:
                    drop /^  \* [a-z0-9._-]+-[0-9]/
                    head-marked 50
                    or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 40 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-40))"; fi; printf '%s\n' "$s" | tail -40
        else:
            match level:
                ultra:
                    keep /(Bundle (complete|updated)|error|ERROR|Could not|Gem::|conflict|warning)/
                    head-marked 15
                    or "bundle: ok"
                lite:
                    drop /^Fetching /
                    head-marked 200
                full:
                    drop /^(Fetching |Resolving dep|Using )/
                    head-marked 50
                    or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 40 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-40))"; fi; printf '%s\n' "$s" | tail -40

exec:
    match level:
        ultra: cap 30
        lite:  cap 300
        else:  cap 100

list|show|outdated:
    match level:
        ultra: cap 20
        lite:  cap 300
        else:  cap 80

*:
    match level:
        ultra: cap 20
        lite:  cap 200
        else:  cap 60

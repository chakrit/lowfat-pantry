#!/usr/bin/env lowfat-filter
# next-compact - keep build warnings/errors and summaries; trim route table at ultra.
# env: $sub $level $exit $args

include ../../lib/truncation.lf

define drop-next-banner:
    drop /^   ▲ Next\.js /
    drop /^   - /
    drop /^   Creating an optimized production build/
    drop /^   Collecting page data/
    drop /^   Generating static pages /
    drop /^   Finalizing page optimization/
    drop /^   Collecting build traces/

build:
    if exit failed:
        raw
    else:
        match level:
            ultra:
                drop-next-banner
                keep /(Compiled successfully|Failed to compile|Warning:|Error:|[0-9]+ warnings?)/
                head-marked 45
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 20 ]; then printf '[lowfat] +%d earlier lines dropped (level=%s) -- output truncated, re-run raw for the full list\n' "$((n-20))" "${level:-full}"; fi; printf '%s\n' "$s" | tail -20
            lite:
                drop-next-banner
                head-marked 140
            else:
                drop-next-banner
                head-marked 90
*:
    if exit failed:
        raw
    else:
        head-auto-marked

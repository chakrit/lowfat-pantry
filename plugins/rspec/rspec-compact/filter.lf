#!/usr/bin/env lowfat-filter
# rspec-compact — collapse passing runs to the tally; on failure keep the
# Failures section, the error block, the summary and the rerun list, drop the
# progress dots and timing chatter.
# env: $sub $level $exit $args

# Any explicit --format/-f (json, html, junit, a custom formatter class) is
# caller-chosen machine output — pass byte-exact (invariant 1). The default
# progress format (no flag) is the common case and still compacts below.
# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

*:
    if --format:
        raw
    elif -f:
        raw
    elif exit ok:
        keep /examples?, \d+ failures?/
        head-marked 1
        or "rspec: passed"
    else:
        match level:
            ultra:
                keep /(^\s+\d+\) |Failure\/Error|^rspec .*#|examples?, .*(failure|error)|LoadError|cannot load|An error occurred)/
                head-marked 30
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 20 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-20))"; fi; printf '%s\n' "$s" | tail -20
            lite:
                drop /^Finished in /
                drop /^[.FE*]+$/
                head-marked 200
            full:
                drop /^Finished in /
                drop /^[.FE*]+$/
                drop /^\s*$/
                head-marked 60
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 40 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-40))"; fi; printf '%s\n' "$s" | tail -40

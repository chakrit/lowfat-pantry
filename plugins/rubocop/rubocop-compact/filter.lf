#!/usr/bin/env lowfat-filter
# rubocop-compact — keep offense lines + the inspected/offenses tally, cap long
# lists with a recovery hint, drop the source-frame/caret pairs and the
# SuggestExtensions "Tip:" block. Clean run -> verdict; error (no offenses,
# nonzero exit) -> raw so the diagnostic survives.
# env: $sub $level $exit $args

define compact-rubocop(limit):
    python: |
        import os, re, sys

        code = os.environ.get("exit", "0")
        lines = sys.stdin.read().splitlines()

        shown, findings, summary = [], 0, None
        for line in lines:
            if re.match(r"^[^:]+:[0-9]+:[0-9]+: [A-Z]: ", line):
                findings += 1
                if len(shown) < $1:
                    shown.append(line)
            elif re.match(r"^[0-9]+ files? inspected", line):
                summary = line

        if findings:
            out = shown + ([summary] if summary else [])
            if findings > len(shown):
                out.append(f"... ({findings} offenses total)")
        elif code == "0":
            out = ["rubocop: clean"]
        else:
            out = lines
        sys.stdout.write("\n".join(out) + "\n" if out else "")

# Any explicit --format/-f (json, junit, sarif, …) is caller-chosen machine
# output — pass byte-exact (invariant 1). The text extraction only ever fit the
# default offense format; the default (no flag) is the common case below.
*:
    if --format:
        raw
    elif -f:
        raw
    else:
        match level:
            ultra: compact-rubocop 15
            full:  compact-rubocop 35
            lite:  compact-rubocop 70

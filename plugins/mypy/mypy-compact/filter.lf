#!/usr/bin/env lowfat-filter
# mypy-compact — keep type errors, keep notes except at ultra, report clean runs.
# env: $sub $level $exit $args

define compact-mypy(limit):
    python: |
        import os, re, sys

        level, code = os.environ.get("level", "full"), os.environ.get("exit", "0")
        lines = sys.stdin.read().splitlines()

        shown, errors, summary, clean = [], 0, None, False
        for line in lines:
            if re.match(r"^[^:]+:[0-9]+: error: ", line):
                errors += 1
                if len(shown) < $1:
                    shown.append(line)
            elif level != "ultra" and re.match(r"^[^:]+:[0-9]+: note: ", line):
                if len(shown) < $1:
                    shown.append(line)
            elif re.match(r"^Found [0-9]+ errors? in ", line):
                summary = line
            elif re.match(r"^Success: no issues found", line):
                clean = True

        if errors:
            out = shown + ([summary] if summary else [])
        elif code == "0" or clean:
            out = ["mypy: clean"]
        else:
            out = lines
        sys.stdout.write("\n".join(out) + "\n" if out else "")

*:
    match level:
        ultra: compact-mypy 15
        full:  compact-mypy 35
        lite:  compact-mypy 70


#!/usr/bin/env lowfat-filter
# poetry-compact — compact poetry lock/install output for LLM contexts.
# env: $sub $level $exit $args
#
# The bloat is per-package install chatter: `  - Installing x (1.2.3)`,
# `  - Updating`, `  - Removing`, `Pending...`. The signal is the
# `Package operations: N installs, …` tally, `Writing lock file`,
# `No dependencies to install`, and any warning. On failure keep the solver
# error block (`SolverProblemError`, `Because`, `version solving failed`,
# `Cannot`). `poetry show -f json` must pass through byte-exact (INVARIANT 1).

include ../../lib/truncation.lf

define drop-progress:
    drop /^[[:space:]]*[-•][[:space:]]+(Installing|Updating|Removing|Downgrading) /
    drop /^[[:space:]]*Pending\.\.\./

*:
    if --format json:
        raw
    elif -f json:
        raw
    elif exit failed:
        match level:
            ultra:
                keep /(SolverProblemError|^Because|version solving failed|Cannot|conflict|[Ee]rror|incompatible|not (found|allowed))/
                head-marked 30
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 30 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-30))"; fi; printf '%s\n' "$s" | tail -30
            lite:
                head-marked 200
            else:
                head-marked 80
    else:
        match level:
            ultra:
                drop-progress
                keep /(Package operations|Writing lock file|No dependencies to install|[Ww]arning|[Ee]rror)/
                head-marked 20
                or "poetry: ok"
            lite:
                drop-progress
                head-marked 200
            else:
                drop-progress
                head-marked 60

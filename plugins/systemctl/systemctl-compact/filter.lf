#!/usr/bin/env lowfat-filter
# systemctl-compact - keep unit state and cap journal tails.
# env: $sub $level $exit $args

include ../../lib/columns.lf
include ../../lib/truncation.lf

# limit = max journal lines to keep; 0 means identity lines only (header,
# Loaded, Active, Main PID). Resource lines (Tasks/Memory/CPU/CGroup) appear
# from limit > 10 up.
define compact-status(limit):
    python: |
        import re, sys

        lines = sys.stdin.read().splitlines()

        out, logs = [], 0
        for index, line in enumerate(lines):
            if index == 0:
                out.append(line)
                continue
            if re.match(r"^[ \t]+(Loaded|Active|Main PID):", line):
                out.append(line)
                continue
            if $1 > 10 and re.match(r"^[ \t]+(Tasks|Memory|CPU|CGroup):", line):
                out.append(line)
                continue
            if re.match(r"^[ \t]*[A-Z][a-z][a-z] [ 0-9][0-9] ", line):
                if logs < $1:
                    out.append(line)
                    logs += 1

        sys.stdout.write("\n".join(out) + "\n" if out else "")

status:
    if exit failed:
        raw
    else:
        match level:
            ultra: compact-status 0
            full:  compact-status 5
            lite:  compact-status 20

list-units:
    if exit failed:
        raw
    else:
        drop /^(LOAD|ACTIVE|SUB)[[:space:]]+= /
        drop /^[[:space:]]*$/
        squeeze-columns

is-active|is-enabled:
    if exit failed:
        raw
    else:
        head 1

*:
    if exit failed:
        raw
    else:
        head-auto-marked

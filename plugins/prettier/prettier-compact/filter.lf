#!/usr/bin/env lowfat-filter
# prettier-compact — compact Prettier status output for LLM contexts.
# env: $sub $level $exit $args
#
# CRITICAL: bare `prettier <file>` prints the *formatted file content* to
# stdout — that must pass through untouched (capping it would corrupt code).
# Only `--check`/`-c` and `--write`/`-w` produce status output worth compacting.
# So we pass raw by default and only compact when a status flag is present.
#
#   --check : `[warn] <file>` per unformatted file + a summary; exit 1 if any.
#   --write : `<file> <Nms>` per file; the bloat is one line per file.
# On a non-zero exit we keep raw — the `[warn]` list or a parse error must show.

# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

# Bare `tail` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped — leading, since
# the drop happened above what survived.
define tail-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[-$1:]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.insert(0, f"[lowfat] +{dropped} earlier lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

*:
    if exit failed:
        raw
    elif --check:
        head-marked 40
        or "prettier: all files formatted"
    elif -c:
        head-marked 40
        or "prettier: all files formatted"
    elif --write:
        match level:
            ultra: tail-marked 6
            lite:  tail-marked 200
            else:  tail-marked 40
    elif -w:
        match level:
            ultra: tail-marked 6
            lite:  tail-marked 200
            else:  tail-marked 40
    else:
        raw

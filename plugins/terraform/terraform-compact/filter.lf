#!/usr/bin/env lowfat-filter
# terraform-compact - preserve plan/apply signal, drop repetitive diffs/progress.
# Serves both `terraform` and `tofu` (OpenTofu) — same subcommands, format-identical output.
# OpenTofu rebrands UI strings (s/Terraform/OpenTofu/), so brand-keyed keeps must alt both
# (see the plan header keep below); brand-free patterns (Plan:, Apply complete!, +/~/- rows) match as-is.
# env: $sub $level $exit $args
#
# `-json` is machine output (ndjson stream) — pass byte-exact (invariant 1).
# Without the guard, compact-plan matches none of it (empty output) and the
# apply/init tails truncate the stream. The guard repeats per compacting rule
# because `.lf` has no top-level pre-filter and macros can't wrap a cascade.

# `head auto` cuts without a trace, so a truncated stream is indistinguishable from a
# genuinely short one and the reader acts on a confident wrong answer (issue #1). Mirrors
# `head auto`'s level limits (ultra 15 / full 30 / lite 60) and names what it dropped.
define head-auto-marked:
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        limit = {"ultra": 15, "lite": 60}.get(level, 30)
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:limit]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define compact-plan(limit):
    python: |
        import os, re, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().splitlines()

        out, count = [], 0
        for line in lines:
            if re.match(r"^  # .* (will be|must be|has been|will be read during apply)", line):
                out.append(line)
                count += 1
                continue
            if re.match(r"^Plan: [0-9]+ to add, [0-9]+ to change, [0-9]+ to destroy\.", line):
                out.append(line)
                continue
            if line.startswith("No changes.") or re.match(r"^(Terraform|OpenTofu) will perform the following actions:", line):
                out.append(line)
                continue
            if level == "ultra":
                continue
            if re.match(r"^[ \t]*[~+-][ \t][A-Za-z0-9_\"-]+[ \t]+=", line):
                if count < $1:
                    out.append(line)
                    count += 1
                continue
            if line.startswith("Changes to Outputs:"):
                out.append(line)

        sys.stdout.write("\n".join(out) + "\n" if out else "")

plan:
    if exit failed:
        raw
    elif -json:
        raw
    else:
        match level:
            ultra: compact-plan 40
            full:  compact-plan 90
            lite:  compact-plan 180

apply:
    if exit failed:
        raw
    elif -json:
        raw
    else:
        match level:
            ultra:
                drop /Still (creating|modifying|destroying|reading)\.\.\. \[[0-9]+s elapsed\]/
                keep /(Creating|Modifying|Destroying|Reading|Creation complete|Modifications complete|Destruction complete|Read complete|Apply complete! Resources:)/
                tail 30
            lite:
                drop /Still (creating|modifying|destroying|reading)\.\.\. \[[0-9]+s elapsed\]/
                tail 120
            else:
                drop /Still (creating|modifying|destroying|reading)\.\.\. \[[0-9]+s elapsed\]/
                tail 60

init:
    if exit failed:
        raw
    elif -json:
        raw
    else:
        match level:
            ultra: tail 20
            lite:  tail 80
            else:  tail 40

# Inventory subcommands emit one load-bearing identifier per line with nothing redundant
# to compact — the whole value is completeness, so they are exempt from compaction.
state:
    raw

output:
    raw

providers:
    raw

workspace:
    raw

*:
    if exit failed:
        raw
    elif -json:
        raw
    else:
        head-auto-marked

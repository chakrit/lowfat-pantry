# Truncation macros shared by the pantry — every rule that drops lines says so, with
# the count (docs/decisions/2026-07-26-visible-truncation.md). Include, don't copy:
#
#     include ../../lib/truncation.lf
#
# The path is relative to the including filter and holds in both trees: the pantry
# source (plugins/<cat>/<name>/) and the install (<LOWFAT_HOME>/plugins/<cat>/<name>/).
# A filter needing its own variant just defines the name locally — a local define wins
# over an included one.

define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define head-auto-marked:
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        limit = {"ultra": 15, "lite": 60}.get(level, 30)
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:limit]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define tail-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[-$1:]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.insert(0, f"[lowfat] +{dropped} earlier lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

define cap(limit):
    python: |
        import sys

        lines = sys.stdin.read().splitlines()

        kept = lines[:$1]
        if len(lines) > len(kept):
            kept.append(f"... ({len(lines)} lines total)")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

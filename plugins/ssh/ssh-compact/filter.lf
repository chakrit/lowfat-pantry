#!/usr/bin/env lowfat-filter
# ssh-compact — compact ssh output for LLM contexts.
# env: $sub $level $exit $args
#
# `ssh -v/-vv/-vvv` floods stderr with `debug1:`/`debug2:`/`debug3:` lines; the
# signal is the connection/auth result, banners, the remote command's output,
# and any error. We drop the debug spam (always safe — it's line-prefixed) and
# cap. A failed connection (non-zero exit) tails to the error.

# Bare `head` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped.
define head-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[:$1]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.append(f"[lowfat] +{dropped} lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

# Bare `tail` cuts without a trace, leaving a truncated stream indistinguishable from a
# genuinely short one (issue #1). Same cap, but it names what it dropped — leading, since
# the drop happened above what survived.
define tail-marked(limit):
    python: |
        import os, sys

        level = os.environ.get("level", "full")
        lines = sys.stdin.read().rstrip("\n").splitlines()

        kept = lines[-$1:]
        dropped = len(lines) - len(kept)
        if dropped > 0:
            kept.insert(0, f"[lowfat] +{dropped} earlier lines dropped (level={level}) -- output truncated, re-run raw for the full list")
        sys.stdout.write("\n".join(kept) + "\n" if kept else "")

*:
    if exit failed:
        match level:
            ultra:
                drop /^debug[0-9]+: /
                tail-marked 30
            lite:
                tail-marked 200
            else:
                drop /^debug[0-9]+: /
                tail-marked 80
    else:
        match level:
            ultra:
                drop /^debug[0-9]+: /
                head-marked 25
            lite:
                head-marked 200
            else:
                drop /^debug[0-9]+: /
                head-marked 60

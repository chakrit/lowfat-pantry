#!/usr/bin/env lowfat-filter
# gradlew-compact - drop task/download progress while keeping Gradle failures.
# env: $sub $level $exit $args

include ../../lib/truncation.lf

define drop-gradle-noise:
    drop /^> Task :[[:alnum:]_.:-]+( UP-TO-DATE| NO-SOURCE| FROM-CACHE| SKIPPED)?$/
    drop /^Download(ing)? /
    drop /^Downloaded /
    drop /^Starting a Gradle Daemon/

define compact-gradle-failure(limit):
    shell: |
        # Error-shaped lines are kept wherever they appear; once the FAILURE
        # block opens, its whole body is signal too. The cap is a plain head
        # because the reference stops appending at the limit.
        sed -E '
        /^(FAILURE:|\* What went wrong:|\* Try:|\* Exception is:)/{s/^/O/;b
        }
        /^BUILD FAILED|^[0-9]+ actionable tasks:|FAILED$|(^|[[:space:]])(FAILED|Error|error|Exception|AssertionError)/{s/^/E/;b
        }
        /^[[:space:]]*$/{s/^/B/;b
        }
        s/^/X/' | {
            in_failure=0
            while IFS= read -r tagged || [ -n "$tagged" ]; do
                line=${tagged#?}
                case $tagged in
                    O*) in_failure=1; printf '%s\n' "$line" ;;
                    E*) printf '%s\n' "$line" ;;
                    X*) [ "$in_failure" = 1 ] && printf '%s\n' "$line" ;;
                esac
            done
        } | head -n $1
        exit 0

*:
    if exit failed:
        match level:
            ultra:
                compact-gradle-failure 50
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 50 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-50))"; fi; printf '%s\n' "$s" | tail -50
            lite:
                compact-gradle-failure 180
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 180 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-180))"; fi; printf '%s\n' "$s" | tail -180
            else:
                compact-gradle-failure 90
                or-shell: s=$(cat); n=$(printf '%s\n' "$s" | wc -l); if [ "$n" -gt 90 ]; then printf '[lowfat] +%d earlier lines dropped -- re-run raw for the full list\n' "$((n-90))"; fi; printf '%s\n' "$s" | tail -90
    else:
        match level:
            ultra:
                drop-gradle-noise
                keep /^(BUILD (SUCCESSFUL|FAILED)|FAILURE:|\* What went wrong:|[0-9]+ actionable tasks:|.*FAILED$|.*Test failed|.*AssertionError)/
                tail-marked 35
                or "gradle: ok"
            lite:
                drop-gradle-noise
                tail-marked 200
            else:
                drop-gradle-noise
                tail-marked 80

